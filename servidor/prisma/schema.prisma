generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id             Int      @id @default(autoincrement())
  nombre         String   @db.VarChar(100)
  correo         String   @unique @db.VarChar(150)
  contrasenaHash String   @map("contrasena_hash") @db.VarChar(255)
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamp(6)

  sesiones       Sesion[]
  recuperaciones Recuperacion[]
  movimientos    Movimiento[]
  limites        LimiteMensual[]
  eventos        Evento[]
  presupuestos   PresupuestoCategoria[]
  recurrencias   Recurrencia[]
  metas          MetaAhorro[]
  movimientosMeta MovimientoMeta[]

  @@map("usuarios")
}

model Sesion {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(255)
  usuarioId Int      @map("usuario_id")
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamp(6)
  expiraEn  DateTime @map("expira_en") @db.Timestamp(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("sesiones")
}

model Recuperacion {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  codigo    String   @db.Char(6)
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamp(6)
  expiraEn  DateTime @map("expira_en") @db.Timestamp(6)
  usado     Boolean  @default(false)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("recuperaciones")
}

model Movimiento {
  id            Int      @id @default(autoincrement())
  usuarioId     Int      @map("usuario_id")
  recurrenciaId Int?     @map("recurrencia_id")
  concepto      String   @db.VarChar(150)
  monto         Decimal  @db.Decimal(12, 2)
  fecha         DateTime @db.Date
  tipo          String   @default("gasto") @db.VarChar(10)
  categoria     String   @default("otros") @db.VarChar(20)
  estado        String   @default("pendiente") @db.VarChar(10)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamp(6)

  usuario     Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  recurrencia Recurrencia? @relation(fields: [recurrenciaId], references: [id], onDelete: SetNull)
  eventos     Evento[]

  @@unique([recurrenciaId, fecha])
  @@map("movimientos")
}

model Recurrencia {
  id           Int      @id @default(autoincrement())
  usuarioId    Int      @map("usuario_id")
  concepto     String   @db.VarChar(150)
  monto        Decimal  @db.Decimal(12, 2)
  categoria    String   @db.VarChar(20)
  frecuencia   String   @db.VarChar(10)
  proximaFecha DateTime @map("proxima_fecha") @db.Date
  activa       Boolean  @default(true)
  creadoEn     DateTime @default(now()) @map("creado_en") @db.Timestamp(6)

  usuario     Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  movimientos Movimiento[]

  @@index([usuarioId])
  @@map("recurrencias")
}

model LimiteMensual {
  id            Int      @id @default(autoincrement())
  usuarioId     Int      @map("usuario_id")
  mes           DateTime @db.Date
  monto         Decimal  @db.Decimal(10, 2)
  actualizadoEn DateTime @default(now()) @map("actualizado_en") @db.Timestamp(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, mes])
  @@map("limites_mensuales")
}

model PresupuestoCategoria {
  id            Int      @id @default(autoincrement())
  usuarioId     Int      @map("usuario_id")
  mes           DateTime @db.Date
  categoria     String   @db.VarChar(20)
  monto         Decimal  @db.Decimal(10, 2)
  actualizadoEn DateTime @default(now()) @map("actualizado_en") @db.Timestamp(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, mes, categoria])
  @@map("presupuestos_por_categoria")
}

model Evento {
  id           Int      @id @default(autoincrement())
  usuarioId    Int      @map("usuario_id")
  tipo         String   @db.VarChar(30)
  movimientoId Int?     @map("movimiento_id")
  monto        Decimal? @db.Decimal(12, 2)
  descripcion  String?  @db.VarChar(200)
  propiedades  Json?
  creadoEn     DateTime @default(now()) @map("creado_en") @db.Timestamp(6)

  usuario    Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  movimiento Movimiento? @relation(fields: [movimientoId], references: [id], onDelete: SetNull)

  @@index([usuarioId, creadoEn(sort: Desc)], map: "idx_eventos_usuario_fecha")
  @@map("eventos")
}

model MetaAhorro {
  id             Int      @id @default(autoincrement())
  usuarioId      Int      @map("usuario_id")
  nombre         String   @db.VarChar(100)
  montoObjetivo  Decimal  @map("monto_objetivo") @db.Decimal(12, 2)
  fechaObjetivo  DateTime @map("fecha_objetivo") @db.Date
  montoReservado Decimal  @default(0) @map("monto_reservado") @db.Decimal(12, 2)
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamp(6)
  actualizadoEn  DateTime @default(now()) @map("actualizado_en") @db.Timestamp(6)

  usuario       Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  movimientos   MovimientoMeta[] @relation("MovimientosMeta")
  transferencias MovimientoMeta[] @relation("MovimientosMetaRelacionada")

  @@unique([usuarioId, nombre])
  @@index([usuarioId])
  @@map("metas_ahorro")
}

model MovimientoMeta {
  id                Int      @id @default(autoincrement())
  usuarioId         Int      @map("usuario_id")
  metaId            Int      @map("meta_id")
  metaRelacionadaId Int?     @map("meta_relacionada_id")
  tipo              String   @db.VarChar(30)
  monto             Decimal  @db.Decimal(12, 2)
  creadoEn          DateTime @default(now()) @map("creado_en") @db.Timestamp(6)

  usuario         Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  meta            MetaAhorro  @relation("MovimientosMeta", fields: [metaId], references: [id], onDelete: Cascade)
  metaRelacionada MetaAhorro? @relation("MovimientosMetaRelacionada", fields: [metaRelacionadaId], references: [id], onDelete: SetNull)

  @@index([usuarioId, creadoEn(sort: Desc)], map: "idx_movimientos_meta_usuario_fecha")
  @@index([metaId])
  @@map("movimientos_meta")
}
