FROM node:24-alpine AS deps
WORKDIR /app

COPY package*.json ./
RUN npm install

FROM node:24-alpine AS runner
WORKDIR /app

RUN apk add --no-cache openssl

COPY --from=deps /app/node_modules ./node_modules
COPY . .

RUN npx prisma generate

RUN chown -R node:node /app
USER node

EXPOSE 3000

CMD ["npm", "run", "dev"]
